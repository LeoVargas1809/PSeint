Algoritmo sin_titulo
	contador=0
	Escribir "cuantas veces desea repetir el programa"
	Leer rep
	Mientras rep>contador Hacer
		Escribir "Digite 2 numeros"
		Leer num1
		Leer num2
		suma=num1+num2
		Escribir "la suma es" suma
		contador=contador+1
		Escribir "el contador lleva" contador "veces"
	FinMientras
FinAlgoritmo
